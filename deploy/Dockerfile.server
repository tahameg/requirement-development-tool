FROM node:20-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY src ./src
COPY scripts/bundle-server.mjs ./scripts/bundle-server.mjs
COPY docs/collab/DEPLOYMENT.md ./docs/collab/DEPLOYMENT.md
COPY deploy/hlr-server.service ./deploy/hlr-server.service
RUN node scripts/bundle-server.mjs /bundle
FROM node:20-bookworm-slim
WORKDIR /app
COPY --from=build /bundle /app
RUN mkdir -p /data && chown node:node /data
USER node
ENV HLR_SERVER_DATA_DIR=/data HLR_SERVER_PORT=8443
EXPOSE 8443
ENTRYPOINT ["node", "/app/server.mjs"]
