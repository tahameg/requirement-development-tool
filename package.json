{
  "name": "hlr-writing-tool",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && node scripts/build-preload.mjs && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "start": "electron .",
    "setup:desktop": "node node_modules/electron/install.js && electron-rebuild -f -w better-sqlite3",
    "test:desktop": "electron tests/integration/electron-smoke.cjs",
    "test:hierarchy": "electron tests/integration/hierarchy-smoke.cjs",
    "test:authoring": "electron tests/integration/authoring-smoke.cjs",
    "prepare:native": "node offline/prepare-native.mjs",
    "package:linux": "node scripts/package.mjs linux",
    "package:appimage": "node scripts/package.mjs linux --target=AppImage",
    "package:deb": "node scripts/package.mjs linux --target=deb",
    "package:windows": "node scripts/package.mjs win32",
    "package:dir": "node scripts/package.mjs linux --dir"
  },
  "dependencies": {
    "better-sqlite3": "12.8.0",
    "ini": "5.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@electron/get": "2.0.3",
    "@electron/rebuild": "3.7.2",
    "@types/better-sqlite3": "7.6.13",
    "@types/ini": "4.1.1",
    "@types/node": "20.17.24",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "3.0.8",
    "electron": "40.10.2",
    "electron-builder": "26.0.12",
    "esbuild": "0.25.12",
    "extract-zip": "2.0.1",
    "typescript": "5.8.2",
    "vite": "6.4.3",
    "vitest": "3.0.8"
  },
  "main": "dist/main/index.js",
  "description": "Offline requirements authoring and systems engineering workspace",
  "author": "HLR Writing Tool contributors",
  "license": "UNLICENSED",
  "homepage": "file:///opt/HLR%20Writing%20Tool/resources/README.md"
}
